<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PhotoThing.App.ViewModels"
             x:Class="PhotoThing.App.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">
  <DockPanel Margin="28,24">

    <StackPanel DockPanel.Dock="Top" Spacing="16">
      <StackPanel Spacing="3">
        <TextBlock Text="Browse" Classes="title"/>
        <TextBlock Text="Your archived library. Thumbnails load without touching cold storage." Classes="muted"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Load library" Classes="accent" Command="{Binding LoadCommand}"/>
        <Button Content="Restore selected" Command="{Binding RestoreSelectedCommand}"/>
        <TextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>

    <Border Classes="card" Margin="0,16,0,0" Padding="10">
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
               Background="Transparent" BorderThickness="0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PhotoItem">
            <Border Width="152" Margin="6" CornerRadius="10"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    ClipToBounds="True">
              <StackPanel>
                <Image Source="{Binding Thumb}" Width="150" Height="132" Stretch="UniformToFill"/>
                <StackPanel Margin="10,8" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding DateText}" Classes="muted" FontSize="11"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</UserControl>
