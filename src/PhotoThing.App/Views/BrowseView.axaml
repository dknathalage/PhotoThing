<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PhotoThing.App.ViewModels"
             x:Class="PhotoThing.App.Views.BrowseView"
             x:DataType="vm:BrowseViewModel"
             Loaded="OnLoaded">
  <Grid>
    <TextBlock IsVisible="{Binding IsEmpty}" Classes="muted"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               TextAlignment="Center"
               Text="Nothing here yet.&#x0a;Add folders and a bucket in Settings, then run a Backup."/>

    <ListBox Classes="photos" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
             Background="Transparent" BorderThickness="0" Padding="10">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PhotoItem">
          <Border Classes="tile" Width="152" Height="152" Margin="3"
                  CornerRadius="6" BorderThickness="2.5" ClipToBounds="True">
            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
