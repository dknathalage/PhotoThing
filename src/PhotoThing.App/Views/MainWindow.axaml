<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PhotoThing.App.Views"
        xmlns:vm="using:PhotoThing.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="680"
        x:Class="PhotoThing.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Background="{StaticResource BgBrush}"
        FontFamily="Avenir Next, Helvetica Neue, sans-serif"
        Title="PhotoThing" Width="1080" Height="720" MinWidth="820" MinHeight="560">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Top bar: brand on the left, actions on the right -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PhotoThing" Classes="h1" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Browse.StatusMessage}" Classes="muted"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Restore" Command="{Binding Browse.RestoreSelectedCommand}"/>
                    <Button Content="Refresh" Command="{Binding Browse.LoadCommand}"/>
                    <Button Content="Backup" Classes="accent" Command="{Binding ShowBackupCommand}"/>
                    <Button Content="Settings" Command="{Binding ShowSettingsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content: the photo grid, with Backup/Settings as overlay panels -->
        <Grid Grid.Row="1">
            <views:BrowseView DataContext="{Binding Browse}"/>

            <!-- Dim backdrop + centered panel -->
            <Border IsVisible="{Binding IsPanelOpen}" Background="#B4000000">
                <Grid>
                    <!-- Backup panel -->
                    <Border Classes="card" IsVisible="{Binding ShowBackupPanel}" Padding="0"
                            MaxWidth="820" MaxHeight="620" Margin="28"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <views:BackupView DataContext="{Binding Backup}"/>
                            <Button Content="✕" Command="{Binding ClosePanelCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"/>
                        </Grid>
                    </Border>
                    <!-- Settings panel -->
                    <Border Classes="card" IsVisible="{Binding ShowSettingsPanel}" Padding="0"
                            MaxWidth="820" MaxHeight="620" Margin="28"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <views:SettingsView DataContext="{Binding Settings}"/>
                            <Button Content="✕" Command="{Binding ClosePanelCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Window>
