<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PhotoThing.App.ViewModels"
             x:Class="PhotoThing.App.Views.BackupView"
             x:DataType="vm:BackupViewModel">
  <DockPanel Margin="28,24">

    <StackPanel DockPanel.Dock="Top" Spacing="16">
      <StackPanel Spacing="3">
        <TextBlock Text="Backup" Classes="title"/>
        <TextBlock Text="Scan your folders and archive anything new or changed." Classes="muted"/>
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <Button Content="Run backup" Classes="accent" Command="{Binding RunBackupCommand}"/>
            <TextBlock Text="{Binding Summary}" Classes="muted"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       IsVisible="{Binding !IsRunning}"/>
            <TextBlock Text="{Binding StatusText}" Classes="muted"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding IsRunning}"/>
          </StackPanel>
          <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                       Height="8" IsVisible="{Binding IsRunning}"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Activity" Classes="h2" Margin="2,4,0,0"/>
    </StackPanel>

    <Border Classes="card" Margin="0,10,0,0" Padding="8">
      <ListBox ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0"/>
    </Border>
  </DockPanel>
</UserControl>
